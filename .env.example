# Copy to .env and fill in. .env is gitignored, never commit real values.

# GCP
GCP_PROJECT_ID=pulseops-dev
GCP_REGION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# BigQuery datasets, one per layer
BQ_DATASET_RAW=pulseops_raw
BQ_DATASET_STAGING=pulseops_staging
BQ_DATASET_MART=pulseops_mart
BQ_DATASET_QUARANTINE=pulseops_quarantine

# Pub/Sub
PUBSUB_TOPIC=pulseops-orders
PUBSUB_SUBSCRIPTION=pulseops-orders-bq

# Vertex AI, used by the copilot in a later phase
VERTEX_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.5-pro
